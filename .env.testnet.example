# PROM testnet profile for the verification network.
# Copy to .env.testnet and fill in before running:
#   forge script script/DeployTestnet.s.sol --profile testnet --rpc-url prom_testnet --broadcast --verify

NODE_ENV=production
PORT=3002

# Network
PROM_TESTNET_RPC_URL=https://rpc.testnet.prom.io
PROM_TESTNET_CHAIN_ID=71234
PROM_TESTNET_EXPLORER_URL=https://explorer.testnet.prom.io
PROM_TESTNET_EXPLORER_API_URL=https://explorer.testnet.prom.io/api
PROM_TESTNET_EXPLORER_API_KEY=

# The service reads these two; they must point at the same network as above.
RPC_URL=https://rpc.testnet.prom.io
CHAIN_ID=71234

# Deployer key. Use a throwaway testnet key, never a mainnet one.
PRIVATE_KEY=

# Contract addresses, filled by DeployTestnet.s.sol output
VALIDATOR_REGISTRY_ADDRESS=
POLICY_REGISTRY_ADDRESS=
VERDICT_REGISTRY_ADDRESS=
SLASHING_REWARDS_ADDRESS=

# Reorg safety: how many confirmations before a verdict is treated as final
BLOCKCHAIN_CONFIRMATIONS=6
