{
  "title": "Verification Throughput",
  "uid": "verif-throughput",
  "schemaVersion": 39,
  "refresh": "30s",
  "panels": [
    { "type": "timeseries", "title": "HTTP req/s", "targets": [{ "expr": "sum(rate(http_requests_total[1m])) by (route)" }] },
    { "type": "timeseries", "title": "p95 latency", "targets": [{ "expr": "histogram_quantile(0.95, sum(rate(http_request_duration_seconds_bucket[5m])) by (le, route))" }] },
    { "type": "stat", "title": "Open disputes", "targets": [{ "expr": "sum(disputes{status=\"open\"})" }] },
    { "type": "stat", "title": "Active validators", "targets": [{ "expr": "sum(validators{status=\"active\"})" }] }
  ]
}
