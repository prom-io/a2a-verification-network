# Copy to .env.staging on the staging host (never commit the real file).
# Used by: docker compose --env-file .env.staging -f docker-compose.staging.yml up -d

# Image to run. IMAGE_TAG is normally supplied by the deploy workflow.
IMAGE_REPOSITORY=your-org/a2a-verification-network
IMAGE_TAG=sha-0000000000000000000000000000000000000000

SERVICE_PORT=3002
LOG_LEVEL=info

# Database
POSTGRES_USER=verification
POSTGRES_PASSWORD=
POSTGRES_DB=verification_db

# API secrets
JWT_SECRET=
CSRF_SECRET=

# Chain (PROM testnet)
CHAIN_ID=71234
BLOCKCHAIN_RPC_URL=
BLOCKCHAIN_PRIVATE_KEY=
BLOCKCHAIN_CONFIRMATIONS=6
VALIDATOR_REGISTRY_ADDRESS=
POLICY_REGISTRY_ADDRESS=
VERDICT_REGISTRY_ADDRESS=
SLASHING_REWARDS_ADDRESS=
PROM_TESTNET_EXPLORER_URL=

# Optional: OTLP collector base URL; tracing stays off when empty.
OTEL_EXPORTER_OTLP_ENDPOINT=
